# Copy this file to `.env.local` and fill in real values.
# `.env.local` is the only local secrets file (gitignored).
# Next.js and Prisma CLI both read `.env.local`.

# App
NEXT_PUBLIC_APP_NAME=StudyFlow
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Runtime
NODE_ENV=development

# Neon (https://neon.tech) — use the "development" branch for local work.
# DATABASE_URL = pooled connection (app runtime / Prisma Client)
# DIRECT_URL   = direct connection (Prisma migrate / CLI via prisma.config.ts)
#
# Neon "production" branch connection strings are set later as Amplify env vars
# during the Deploy step — do not commit them.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Auth.js
# Generate: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Amazon Cognito
# Issuer: https://cognito-idp.{region}.amazonaws.com/{userPoolId}
AUTH_COGNITO_ID=
AUTH_COGNITO_SECRET=
AUTH_COGNITO_ISSUER=
# Hosted UI / managed login domain (no trailing slash)
# Example: https://your-prefix.auth.ap-southeast-2.amazoncognito.com
AUTH_COGNITO_DOMAIN=

# Cognito app client (AWS Console) — set these exactly:
# Allowed callback URL:
#   http://localhost:3000/api/auth/callback/cognito
# Allowed sign-out (logout) URL:
#   http://localhost:3000
# OAuth grant: Authorization code
# Scopes: openid email profile phone
