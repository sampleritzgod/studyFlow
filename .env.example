# Copy this file to `.env.local` and fill in real values.
# `.env.local` is the only local secrets file (gitignored).
# Next.js and Prisma CLI both read `.env.local`.

# App
NEXT_PUBLIC_APP_NAME=StudyFlow
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Runtime
NODE_ENV=development

# Neon (https://neon.tech) — use the "development" branch for local work.
# DATABASE_URL = pooled connection (app runtime / Prisma Client)
# DIRECT_URL   = direct connection (Prisma migrate / CLI via prisma.config.ts)
#
# Neon "production" branch connection strings are set later as Vercel env vars
# during the Deploy step — do not commit them.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional path helpers (recommended with hosted SignIn / SignUp components)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
