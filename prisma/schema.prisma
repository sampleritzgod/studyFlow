generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Prisma 7: URLs live in prisma.config.ts / .env.local (not here).
// Runtime: DATABASE_URL (pooled) via src/lib/prisma.ts
// CLI/migrations: DIRECT_URL via prisma.config.ts

model Note {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outgoingLinks NoteLink[] @relation("NoteOutgoing")
  incomingLinks NoteLink[] @relation("NoteIncoming")

  @@index([userId])
}

/// Directed edge; app treats A↔B as bidirectional by querying both directions.
model NoteLink {
  id         String   @id @default(cuid())
  userId     String
  fromNoteId String
  toNoteId   String
  createdAt  DateTime @default(now())

  fromNote Note @relation("NoteOutgoing", fields: [fromNoteId], references: [id], onDelete: Cascade)
  toNote   Note @relation("NoteIncoming", fields: [toNoteId], references: [id], onDelete: Cascade)

  @@unique([fromNoteId, toNoteId])
  @@index([userId])
  @@index([toNoteId])
}

enum FocusSessionKind {
  POMODORO
  BLOCK
}

enum FocusSessionStatus {
  RUNNING
  COMPLETED
  ABANDONED
}

model FocusSession {
  id             String             @id @default(cuid())
  userId         String
  kind           FocusSessionKind
  label          String             @default("")
  plannedMinutes Int
  startedAt      DateTime           @default(now())
  endedAt        DateTime?
  status         FocusSessionStatus @default(RUNNING)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([userId, startedAt])
  @@index([userId, status])
}

enum Plan {
  FREE
  PRO
}

enum SubscriptionStatus {
  INACTIVE
  ACTIVE
  PAST_DUE
  CANCELED
}

model UserSubscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  plan                 Plan               @default(FREE)
  status               SubscriptionStatus @default(INACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([stripeCustomerId])
}
